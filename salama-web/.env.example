# Salama Web VPN — copy to .env and fill in. In Coolify, set these in the
# resource's Environment Variables UI instead of committing a .env file.

# REQUIRED — the public IP or domain of this server (what clients dial).
WG_HOST=vpn.seedexr.com

# REQUIRED — bcrypt hash of the admin web-UI password.
# Generate:  docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'your-strong-password'
# Paste the hash EXACTLY as printed — raw, single '$'. This compose reads the
# hash via ${PASSWORD_HASH}, so do NOT double the '$'. (The "$$" doubling advice
# you'll see elsewhere only applies to writing the hash INLINE in a compose
# file, which we don't do here.) Same in Coolify's env UI: paste it raw.
PASSWORD_HASH=$2a$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — change if UDP 51820 is already taken by another deployment.
WG_PORT=51820

# Optional — DNS given to VPN clients (defaults to Quad9, matching Salama).
WG_DEFAULT_DNS=9.9.9.9

# Optional — web UI language.
LANG=en
