# Salama Web VPN — copy to .env and fill in. In Coolify, set these in the
# resource's Environment Variables UI instead of committing a .env file.

# REQUIRED — the public IP or domain of this server (what clients dial).
WG_HOST=vpn.seedexr.com

# REQUIRED — bcrypt hash of the admin web-UI password.
# Generate:  ./gen-password.sh   (or: docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'pw')
#
# Setting it correctly matters because a bcrypt hash contains '$' signs:
#   • Coolify (recommended): paste the hash RAW (single '$') into the resource's
#     Environment Variables UI. A real env var is substituted verbatim, so no
#     escaping is needed there.
#   • This .env FILE: `docker compose` INTERPOLATES .env values, so a raw '$'
#     would be corrupted — you must DOUBLE every '$' -> '$$' (as shown below).
#     `./gen-password.sh --env` writes the doubled form for you.
#   • Or skip .env locally and `export PASSWORD_HASH='<raw hash>'` before `up`.
PASSWORD_HASH=$$2a$$12$$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — change if UDP 51820 is already taken by another deployment.
WG_PORT=51820

# Optional — DNS given to VPN clients (defaults to Quad9, matching Salama).
WG_DEFAULT_DNS=9.9.9.9

# Optional — web UI language.
LANG=en
